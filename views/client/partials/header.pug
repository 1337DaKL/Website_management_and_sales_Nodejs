include ../mixins/tree-category.pug
header.header
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark     
        div(class="d-flex align-items-center")
            a(href="/")
                img(src="https://th.bing.com/th?q=1337+Transparent+Logo&w=120&h=120&c=1&rs=1&qlt=90&cb=1&dpr=1.3&pid=InlineBlock&mkt=en-WW&cc=VN&setlang=en&adlt=strict&t=1&mw=247", alt="logo", height="50px")
            h1.mb-0.ms-2(style="margin-right: 80px;") Cửa hàng 1337_DaKL

        form(id="form-search" action="/search" method="GET")  
            .input-group
                .col-9
                    .input-group
                        input.form-control(
                            type="text"
                            placeholder="Nhập từ khóa"
                            name="keyword"
                            value=keyword
                        )
                        button.btn.btn-light.btn-no-border(type="button" id="button-clear" style="background-color: white;")
                            i(class="fa fa-times" style="color: black;")

                .input-group-append
                    button(
                        class="btn"
                        type="submit"
                    )   
                       i.bi.bi-search(style="color: white;")
        ul.navbar-nav.ml-auto
            li.nav-item
                a.nav-link(href="/") Trang Chủ
            li.nav-item
                a.nav-link(href="/about") Giới Thiệu
            li.nav-item.sub-menu
                a.nav-link(href="/products") Sản phẩm
                +tree-category(categoryTree)
            li.nav-item
                a.nav-link(href="/contact") Liên Hệ
            li.nav-item
                a.nav-link(href="/cart") Giỏ hàng 
                    b(style="color:red;") (#{countProductInCart ? countProductInCart : "0"})
            if userLoginClient
                
                div.avatar(style="display: flex; flex-direction: column; align-items: center; position: relative;margin-right: 40px;")
                    img(src="avatar.jpg" alt="Avatar" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover; border: 2px solid #ccc; margin-right: 10px;")
                    p.name(style="margin-top: 10px; font-size: 16px; color: white; font-weight: bold; font-size: 12px;") #{userLoginClient.fullName}
                    button.nav-link( style="position: absolute; top: 0; right: -60px;  cursor: pointer; " button-logout) Đăng xuất

            else
                li.nav-item
                    a.nav-link(href="/user/login") Đăng nhập
                li.nav-item
                    a.nav-link(href="/user/register") Đăng kí
