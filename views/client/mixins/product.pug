mixin product(products)
  each item in products
    .col-4.mb-3
      .product-item
        .inner-image
          img(src=item.thumbnail width="200" height="150")
          if item.featured == "1"
            .inner-featured Nổi bật
        .inner-content
          h3.inner-title #{item.title}
          if item.discount != null
            .inner-price-new Giá mới: #{item.newPrice} vnđ
            .inner-price-old Giá cũ: #{item.priceString} vnđ   
          else 
            .inner-price-new Giá : #{item.priceString} vnđ
            .inner-price-old(style=" opacity: 0;") Giá cũ: #{item.priceString} vnđ 
          if item.discount != null
            .inner-discount Giảm giá: #{item.discount} %
          else 
            .inner-discount(style ="visibility: hidden;") ddd

          // Nút thêm vào giỏ hàng và chi tiết
          .product-actions
            form(action="/cart/add/#{item.id}" method="POST")
                button.bi.bi-cart-plus(type="submit") 
            a(href=`/products/detel/${item.slug}` class="btn btn-detail") Chi tiết

