extends ../../layouts/defaut.pug
include ../../mixins/box-head.pug
block main
    .container.my-3
        .row
            .col-12
                +box-head("Đặt hàng thành công ")
        if(order)
            .row
                .col-12 
                    div(class="alert alert-success")
                        | Chúc mừng bạn đã đặt hàng thành công! Chúng tôi sẽ sử lý đơn hàng với thời gian sớm nhất. Vui lòng để ý gmail để xem thông tin của đơn hàng
            .row 
                .col-12 
                    h4(class="mb-2") Thông tin cá nhân 
                    table(class="table table-bordered")
                        tbody
                            tr
                                td Họ và tên 
                                td 
                                    b #{order.userInfor.fullName}
                            tr
                                td Số điện thoại 
                                td 
                                    b #{order.userInfor.telephone} 
                            tr
                                td Email
                                td 
                                    b #{order.userInfor.email}
                            tr
                                td Địa chỉ
                                td 
                                    b #{order.userInfor.address}
        if(order.products.length > 0)
            .row 
                .col-12
                    h4(class="mb-2") Thông tin đơn hàng
                    table(class="table table-bordered")
                        thead 
                            tr 
                                th STT 
                                th Ảnh 
                                th Tên 
                                th Giá
                                th Số lượng 
                                th Tổng tiền 
                        tbody 
                            each item , index in order.products
                                tr 
                                    td #{index + 1}
                                    td 
                                        img(src=item.productInfor.thumbnail, alt="Anh san pham" width="100px" height="100px")
                                    td 
                                        a(href=`products/detel/${item.productInfor.slug}`) #{item.productInfor.title}
                                    if item.priceString
                                        td #{item.priceString} vnđ
                                    else    
                                        td Lỗi
                                    td #{item.quantity}
                                    if item.totalString
                                        td #{item.totalString} vnđ
                                    else 
                                        td Lỗi
                    h3(class="text-right") Tổng đơn hàng: 
                        b #{totalCart} vnđ
