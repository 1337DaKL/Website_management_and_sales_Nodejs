extends ../../layouts/defaut.pug
include ../../mixins/box-head.pug
block main
    .container.my-3
        .row
            .col-12
                +box-head("Giỏ hàng")
        if product.length > 0  
            .row 
                .col-12
                    table(class="table table-bordered")
                        thead 
                            tr 
                                th STT 
                                th Ảnh 
                                th Tên 
                                th Giá
                                th Số lượng 
                                th Tổng tiền 
                                th Hành động
                        tbody 
                            each item , index in product
                                tr 
                                    td #{index + 1}
                                    td 
                                        img(src=item.product.thumbnail, alt="Anh san pham" width="100px" height="100px")
                                    td 
                                        a(href=`products/detel/${item.product.slug}`) #{item.product.title}
                                    if item.priceString
                                        td #{item.priceString} vnđ
                                    else    
                                        td Lỗi
                                    td 
                                        input(
                                            type="number"
                                            name="quantity"
                                            value=item.quantity
                                            min="1"
                                            max=item.product.stock
                                            item-id=item.productId
                                            style ="width : 60px;"
                                            )
                                    if item.totalPriceString
                                        td #{item.totalPriceString} vnđ
                                    else 
                                        td Lỗi
                                    td 
                                        button(class="btn btn-danger" id=item.productId button-delete) Xóa
                    h3(class="text-right") Tổng đơn hàng: #{totalCart} vnđ
                    div(class="text-right mt-3")
                        a(href="/checkout" class="btn btn-success") THANH TOÁN
                    form(action="", method="post" delete-form) 
                    form(action="", method="post"  form-change-quantity) 
            script(src="/client/js/cart.js") 
        else 
            .container.mt-5
                        .row.justify-content-center
                            .col-md-6
                                .alert.alert-warning.text-center
                                    i.bi.bi-exclamation-triangle-fill 
                                    | Bạn chưa chọn sản phẩm nào!! Vui lòng chọn sản phâm ưng ý r mới thanh toán