extends ../../layouts/defaut.pug
include ../../mixins/box-head.pug
block main
    .container.my-5 
        .row.justify-content-center
            .col-8  
                h1(class="text-center") Lấy lại mật khẩu
                form(
                    action="/user/password/forgot"
                    method="POST"
                )
                    div(class="form-group")
                        label(for="email") Email
                        input(
                            type="text"
                            class="form-control"
                            id="email"
                            name="email"
                            placeholder="Nhập email để lấy lại mật khẩu"
                            require
                        )
                    div(clas="form-control")
                        button(
                            type="submit"
                            class="btn btn-primary btn-block"

                        ) Gửi
                div(style="margin-bottom: 325px;")