extends ../../layouts/defaut.pug
block main
    h1(class="mb-4") Chỉnh sửa thông tin cá nhân
    form(
        action=`/user/change-infor?_method=PATCH`
        id="form-edit"
        method="POST"
        enctype="multipart/form-data"
    )
        div(class="form-group")
            label(for="fullName") Họ và tên *
            input(
                type="text"
                class="form-control"
                id="fullName"
                name="fullName"
                placeholder="Nhập họ và tên ..."
                value=user.fullName
                required
            )
        div(class="form-group")
            label(for="email") Email*
            input(
                type="text"
                class="form-control"
                id="email"
                name="email"
                placeholder="Nhập email ..."
                value=user.email
                required
            ) 
        div(class="form-group")
            label(for="address") Địa chỉ
            input(
                id="address"
                name="address"
                type="text"
                class="form-control"
                placeholder="Nhập địa chỉ"
                value=user.address
            )
        div(class="form-group") 
            label(for="telephone") Số điện thoại
            input(
                id="telephone"
                name="telephone"
                type="text"
                placeholder="Nhập số điện thoại ..."
                class="form-control"
                value=user.telephone
            )
        div(class="form-group" upload-image)
            label(for="avartar") Tải ảnh 
            input(
                id="avartar"
                name="avartar"
                type="file"
                class="form-control-file"
                accept=".jpg, .png"
                value = user.avartar
                input-image
            )
            button(type="button" id="clearUpload" clear-upload) X
            br
            img(
                id="blah" 
                src=user.avartar 
                alt="Ảnh bạn đã tải lên" 
                img-image 
                width="200px" 
                height="200px"
            )
        div(class="form-group")
            button(
                type="submit"
                class="btn btn-primary"
            ) Cập nhật