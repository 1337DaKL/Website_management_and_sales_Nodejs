extends ../../layouts/defaut.pug
include ../../mixins/box-head.pug
block main
    .container.my-5 
        .row.justify-content-center
            .col-8  
                h1(class="text-center") Nhập mã OTP
                form(
                    action="/user/password/otp"
                    method="POST"
                )
                    div(class="form-group")
                        label(for="email") Email
                        input(
                            type="text"
                            class="form-control"
                            id="email"
                            name="email"
                            value=email
                            require
                            readonly
                        )
                    div(class="form-group")
                        label(for="otp") OTP
                        input(
                            type="text"
                            class="form-control"
                            id="otp"
                            name="otp"
                            placeholder="Nhập mã OTP lấy từ email đã được nhận"
                            require
                        )
                    div(clas="form-control")
                        button(
                            type="submit"
                            class="btn btn-primary btn-block"

                        ) Xác nhận
                div(style="margin-bottom: 310px;")