extends ../../layouts/defaut.pug
include ../../mixins/box-head.pug
block main
    .container.my-5 
        .row.justify-content-center
            .col-8  
                h1(class="text-center") Đổi mật khẩu
                form(
                    action="/user/password/reset"
                    method="POST"
                )
                    div(class="form-group")
                        label(for="password") Mật khẩu mới
                        input(
                            type="password"
                            class="form-control"
                            id="password"
                            name="password"
                            placeholder="Nhập mật khẩu mới"
                            require
                        )
                        label(for="confirmPassword") Xác nhận mật khẩu
                        input(
                            type="password"
                            class="form-control"
                            id="confirmPassword"
                            name="confirmPassword"
                            placeholder="Xác nhận mật khẩu mới"
                            require
                        )
                    div(clas="form-control")
                        button(
                            type="submit"
                            class="btn btn-primary btn-block"

                        ) Xác nhận
                div(style="margin-bottom: 250px;")