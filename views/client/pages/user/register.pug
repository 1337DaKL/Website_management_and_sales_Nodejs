extends ../../layouts/defaut.pug
include ../../mixins/box-head.pug
block main
    .container.my-5 
        .row.justify-content-center
            .col-8  
                h1(class="text-center") Đăng kí tài khoản
                form(
                    action="/user/register"
                    method="POST"
                    style="margin-bottom: 160px;"
                )
                    div(class="form-group")
                        label(for="fullName") Họ và tên 
                        input(
                            type="text"
                            class="form-control"
                            id="fullName"
                            name="fullName"
                            require
                        )
                        label(for="email") Email
                        input(
                            type="text"
                            class="form-control"
                            id="email"
                            name="email"
                            require
                        )
                        label(for="password") Mật khẩu
                        input(
                            type="text"
                            class="form-control"
                            id="password"
                            name="password"
                            require
                        )
                    dix(clas="form-control")
                        button(
                            type="submit"
                            class="btn btn-primary btn-block"

                        ) Đăng kí