mixin print-products(products)
    if products.length > 0 
        thead 
                tr
                    th
                        input(type="checkbox" name="checkall")
                    th STT 
                    th Hình ảnh 
                    th Tiêu đề 
                    th Giá 
                    th Vị trí
                    th Trạng thái 
                    th Ngày tạo
                    th Ngày cập nhật gần nhất
                    th Hành động 
        tbody 
            each item, index in products 
                tr 
                    td
                        input(type="checkbox" name="id" value=item.id)
                    -const stt = (pagination.currentPage - 1) * pagination.limitPage + (index + 1)
                    td #{stt}
                    td 
                        img(src=item.thumbnail, alt=item.title, width="100px", height="auto")
                    td #{item.title}
                    td #{item.priceString} vnđ   
                    td 
                        input(
                            type="number"
                            value=item.position
                            style="width: 60px"
                            min="1"
                            name="position"
                            position-change
                        )
                    td(id="swap-status")
                        if roleLogin.permission.includes("products_edit") 
                            if(item.status == "active")
                                a(
                                    href="javascript:;" 
                                    class="badge badge-success"
                                    change-status 
                                    status = item.status
                                    id = item.id
                                ) Hoạt động
                            else 
                                a(
                                    href="javascript:;" 
                                    class="badge badge-danger"
                                    change-status 
                                    status = item.status
                                    id = item.id
                                    ) Không hoạt động
                        else 
                            if(item.status == "active")
                                a(
                                    class="badge badge-success"
                                ) Hoạt động
                            else 
                                a(
                                    class="badge badge-danger"
                                    ) Không hoạt động
                    td 
                        if item.createdBy
                            - const date = moment(item.createdBy.dateCreated).format("DD/MM/YYYY HH:mm:ss")
                            if item.nameCreated
                                p Người tạo: #{item.nameCreated}
                            else 
                                p Người tạo: Không có
                            p #{date}
                    td 
                        if item.updatedBy.length > 0
                            - const dateUpdate = moment(item.timeLastUpdated).format("DD/MM/YYYY HH:mm:ss")
                            p Người cập nhật: #{item.nameAccountUpdated}
                            p #{dateUpdate}
                    td 
                        if roleLogin.permission.includes("products_view")
                            a.btn.btn-success.btn-sm(href=`${frefixAdmin}/products/detel/${item.id}`) Chi tiết
                            d 
                        if roleLogin.permission.includes("products_edit")
                            a.btn.btn-warning.btn-sm(href=`${frefixAdmin}/products/edit/${item.id}`) Sửa
                        if roleLogin.permission.includes("products_delete")
                            button(class="btn btn-danger btn-sm ml-1" id-product=item.id button-delete) Xóa
    else 
        .container.mt-5
            .row.justify-content-center
                .col-md-6
                    .alert.alert-warning.text-center
                        i.bi.bi-exclamation-triangle-fill 
                        | Không có sản phẩm nào!!

    form(action="", method="POST" id="form-change" path="products/change-status/") 
    form(action="" method="POST" id="form-delete" path=`${frefixAdmin}/products/delete`)