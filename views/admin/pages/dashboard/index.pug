extends ../../layouts/defaut.pug
block main
    .container
            h1 Thông tin tài khoản
            .row 
                .col-md-2
                .col-md-6
                    div
                        h4 Họ và tên: #{userLogin.fullName}
                        h4 Quyền quản trị: #{roleLogin.title}
            h1 Tổng quan thống Kê
            .row
                .col-md-6
                    h2 Tài khoản
                    table.table.table-bordered
                        thead
                            tr
                                th Thống kê
                                th Số lượng
                        tbody
                            tr
                                td Tổng
                                td #{account.countObject}
                            tr
                                td Đang hoạt động
                                td #{account.countActive}
                            tr
                                td Dừng hoạt động
                                td #{account.countInactive}
                .col-md-6
                    h2 Đơn hàng
                    table.table.table-bordered
                        thead
                            tr
                                th Thống kê
                                th Số lượng
                        tbody
                            tr
                                td Tổng
                                td #{account.countObject}
                            tr
                                td Đang hoạt động
                                td #{account.countActive}
                            tr
                                td Dừng hoạt động
                                td #{account.countInactive}
            .row
                .col-md-6
                    h2 Danh mục sản phẩm
                    table.table.table-bordered
                        thead
                            tr
                                th Thống kê
                                th Số lượng
                        tbody
                            tr
                                td Tổng
                                td #{productCategory.countObject}
                            tr
                                td Đang hoạt động
                                td #{productCategory.countActive}
                            tr
                                td Dừng hoạt động
                                td #{productCategory.countInactive}
                .col-md-6
                    h2 Sản phẩm
                    table.table.table-bordered
                        thead
                            tr
                                th Thống kê
                                th Số lượng
                        tbody
                            tr
                                td Tổng
                                td #{product.countObject}
                            tr
                                td Đang hoạt động
                                td #{product.countActive}
                            tr
                                td Dừng hoạt động
                                td #{product.countInactive}
            .row
                .col-md-6
                    h2 Danh mục bài viết
                    table.table.table-bordered
                        thead
                            tr
                                th Thống kê
                                th Số lượng
                        tbody
                            tr
                                td Tổng
                                td #{postCategory.countObject}
                            tr
                                td Đang hoạt động
                                td #{postCategory.countActive}
                            tr
                                td Dừng hoạt động
                                td #{postCategory.countInactive}
                .col-md-6
                    h2 Bài viết
                    table.table.table-bordered
                        thead
                            tr
                                th Thống kê
                                th Số lượng
                        tbody
                            tr
                                td Tổng
                                td 10
                            tr
                                td Đang hoạt động
                                td 2
                            tr
                                td Dừng hoạt động
                                td 2
            .row
                .col-md-6
                    h2 Tin nhắn
                    table.table.table-bordered
                        thead
                            tr
                                th Thống kê
                                th Số lượng
                        tbody
                            tr
                                td Tổng
                                td #{messenger.countObject}
                            tr
                                td Đã xem
                                td #{messenger.countSeen}
                            tr
                                td Chưa xem
                                td #{messenger.countNotSeen}
                .col-md-6
                    h2 Quyền quản trị
                    table.table.table-bordered
                        thead
                            tr
                                th Thống kê
                                th Số lượng
                        tbody
                            tr
                                td Tổng
                                td #{role.countObject}
                            tr
                                td Đang hoạt động
                                td #{role.countActive}
                            tr
                                td Dừng hoạt động
                                td #{role.countInactive}