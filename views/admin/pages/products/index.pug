extends ../../layouts/defaut.pug
include ../../mixins/filter-status.pug
include ../../mixins/search.pug
include ../../mixins/products.pug
include ../../mixins/pagination.pug
include ../../mixins/change-status-multi.pug
include ../../mixins/sort.pug
block main
    h1 Trang quản lí sản phẩm
    if roleLogin.permission.includes("products_view")
        br
        .card.mb-3 
            .card-header Bộ lọc và tìm kiếm
            .card-body
                .row 
                    .col-4
                        +filter-status(filtersStatus)  
                    .col-6
                        +search(keyword)
                    .col-2
                        if roleLogin.permission.includes("products_create")
                            a(
                                href=`${frefixAdmin}/products/create`
                                class="btn btn-outline-success"
                            ) +Thêm mới sản phẩm
                .row
                    +change-status-multi()
                    +sort() 
        table(
            class="table table-hover table-sm"
            change-status-multi
        )
            +print-products(products)
        +pagination(pagination)
        script(src="/admin/js/product.js") 
    else 
        h2(style="color: red;") Bạn không có quyền xem trang này