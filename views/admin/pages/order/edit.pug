extends ../../layouts/defaut.pug
block main
    .container.my-3
        .row
            .col-12
                h1 
                    b Chỉnh sửa đơn hàng
        .container.my-3
            .row 
                .col-12 
                    h4(class="mb-2") Thông tin người nhận hàng
                    form(
                        action=`${frefixAdmin}/account/edit/${order.id}}?_method=PATCH`
                        id="form-edit"
                        method="POST"
                        enctype="multipart/form-data"
                    )
                        div(class="form-group")
                            label(for="fullName") Họ và tên *
                            input(
                                type="text"
                                class="form-control"
                                id="fullName"
                                name="fullName"
                                placeholder="Nhập họ và tên ..."
                                value=order.userInfor.fullName
                                required
                            )
                        div(class="form-group")
                            label(for="email") Email*
                            input(
                                type="text"
                                class="form-control"
                                id="email"
                                name="email"
                                placeholder="Nhập email ..."
                                value=order.userInfor.email
                                required
                            ) 
                        div(class="form-group")
                            label(for="address") Địa chỉ
                            input(
                                id="address"
                                name="address"
                                type="text"
                                class="form-control"
                                placeholder="Nhập địa chỉ"
                                value=order.userInfor.address
                                required
                            )
                        div(class="form-group") 
                            label(for="telephone") Số điện thoại
                            input(
                                id="telephone"
                                name="telephone"
                                type="text"
                                placeholder="Nhập số điện thoại ..."
                                class="form-control"
                                value=order.userInfor.telephone
                                required
                            )
                    div(class="form-group")
                            button(
                                type="submit"
                                class="btn btn-primary"
                            ) Cập nhật thông tin người 
            .row 
                .col-12 
                    h4(class="mb-2") Thông tin sản phẩm
                    if true
                        .row 
                            .col-12
                                table(class="table table-bordered")
                                    thead 
                                        tr 
                                            th STT 
                                            th Ảnh 
                                            th Tên 
                                            th Giá
                                            th Số lượng 
                                            th Tổng tiền 
                                            th Hành động
                                    tbody 
                                        //- each item , index in product
                                        tr 
                                            td #{ + 1}
                                            td 
                                                //- img(src="", alt="Anh san pham" width="100px" height="100px")
                                            td 
                                                a(href=`products/detel/`) 
                                            if true
                                                td  vnđ
                                            else    
                                                td Lỗi
                                            td 
                                                input(
                                                    type="number"
                                                    name="quantity"
                                                    value=1
                                                    min="1"
                                                    max=1
                                                    item-id=1
                                                    style ="width : 60px;"
                                                    )
                                            if true
                                                td 1 vnđ
                                            else 
                                                td Lỗi
                                            td 
                                                button(class="btn btn-danger" id=1 button-delete) Xóa
                                h3(class="text-right") Tổng đơn hàng: 1
                                div(class="text-right mt-3")
                                form(action="", method="post" delete-form) 
                                form(action="", method="post"  form-change-quantity) 