extends ../../layouts/defaut.pug
include ../../mixins/filter-status.pug
include ../../mixins/search.pug
include ../../mixins/categorys.pug
include ../../mixins/pagination.pug
include ../../mixins/change-multi-category.pug
include ../../mixins/sort-category.pug
block main
    h1 
        b Trang quản lí đơn hàng 
    if roleLogin.permission.includes("order_view")
        br
        .card.mb-3 
            .card-header Bộ lọc và tìm kiếm
            .card-body
                .row 
                    .col-4
                        //- +filter-status(filtersStatus)  
                    .col-6
                        //- +search(keyword)
                .row
                    if roleLogin.permission.includes("order_edit")
                        form.form-change-multi(
                            action=`${frefixAdmin}/order/change-multi?_method=PATCH`, 
                            method="POST"
                            form-change-multi
                        )
                            .d-flex.align-items-start
                                .form-group.mr-2
                                    select.form-control(name="type" select-option)
                                        if roleLogin.permission.includes("order_edit")
                                            option(disabled selected) --Chọn hành động--
                                            option(value="pending") Chờ xác nhận
                                            option(value="confirmed") Đã xác nhận
                                            option(value="packing") Đang đóng gói
                                            option(value="shipped") Đã gửi cho đơn vị vận chuyển
                                            option(value="delivered") Giao hàng thành công
                                            option(value="completed") Đơn hàng hoàn tất
                                        if roleLogin.permission.includes("order_delete")
                                            option(value="delete") Xóa
                                .form-group.mr-2
                                    input.form-control.d-none(
                                        type="text"
                                        name="ids"
                                        value=""
                                        placeholder="San pham ap dung"
                                        input-submit
                                    )
                                button.btn.btn-primary(type="submit") Áp dụng
        //-             +sort() 
        table(
            class="table table-hover table-sm"
        )
            if orders.length > 0
                thead 
                        tr
                            th
                                input(type="checkbox" name="checkall")
                            th STT 
                            th Tài khoản đặt
                            th Trạng thái 
                            th Ngày đặt hàng
                            th Ngày cập nhật gần nhất
                            th Hành động 
                tbody 
                    each item, index in orders 
                        tr 
                            td
                                input(type="checkbox" name="id" value=item.id)
                            //- -const stt = (pagination.currentPage - 1) * pagination.limitPage + (index + 1)
                            td #{index + 1}
                            if item.user
                                td #{item.user.fullName}
                            else 
                                td  Khách vãng lai
                            td(id="swap-status")
                                p #{item.statusTranscripted}
                            td 
                                if item.dateOrder
                                    - const date = moment(item.dateOrder).format("HH:mm:ss DD/MM/YYYY")
                                    p #{date}
                            td 
                                if item.lastUpdated
                                    - const dateUpdated = moment(item.lastUpdated.dateUpdated).format("DD/MM/YYYY HH:mm:ss")
                                    p #{dateUpdated}
                                else 
                                    p Không có thay đổi nào
                            td 
                                if roleLogin.permission.includes("products-category_view")
                                    a.btn.btn-success.btn-sm(href=`${frefixAdmin}/categorys/detel/${item.id}`) Chi tiết
                                    d 
                                if roleLogin.permission.includes("products-category_edit")
                                    a.btn.btn-warning.btn-sm(href=`${frefixAdmin}/categorys/edit/${item.id}`) Sửa
                                if roleLogin.permission.includes("products-category_delete")
                                    button(class="btn btn-danger btn-sm ml-1" id-product=item.id button-delete) Xóa
            else 
                .container.mt-5
                    .row.justify-content-center
                        .col-md-6
                            .alert.alert-warning.text-center
                                i.bi.bi-exclamation-triangle-fill 
                                | Không có đơn hàng nào!!
        +pagination(pagination)
        script(src="/admin/js/order.js") 
    else 
        h2(style="color: red;") Bạn không có quyền xem trang này