extends ../../layouts/defaut.pug
include ../../mixins/filter-status.pug
include ../../mixins/search.pug
include ../../mixins/products.pug
include ../../mixins/pagination.pug
include ../../mixins/change-status-multi.pug
include ../../mixins/sort.pug
block main
    h1 Tài khoản
    br
    .card.mb-3 
        .card-header Bo loc va tim kiem
        .card-body
            .row 
                .col-4
                    +filter-status(filtersStatus)  
                .col-6
                    +search(keyword)
                .col-2
                    a(
                        href=`${frefixAdmin}/account/create`
                        class="btn btn-outline-success"
                    ) +Thêm mới tài khoản
            .row
                form.form-change-multi(
                    action=`${frefixAdmin}/account/change-multi?_method=PATCH`, 
                    method="POST"
                    form-change-multi
                )
                    .d-flex.align-items-start
                        .form-group.mr-2
                            select.form-control(name="type" select-option)
                                option(disabled selected) --Chọn hành động--
                                option(value="active") Hoạt động 
                                option(value="inactive") Dừng hoạt động 
                                option(value="delete") Xóa 
                        .form-group.mr-2
                            input.form-control.d-none(
                                type="text"
                                name="ids"
                                value=""
                                placeholder="San pham ap dung"
                                input-ids
                            )
                        button.btn.btn-primary(type="submit") Áp dụng
    table(
        class="table table-hover table-sm"
        change-status-multi
    )
        if accounts.length > 0 
            thead 
                    tr
                        th
                            input(type="checkbox" name="checkall")
                        th STT 
                        th Ảnh đại diện
                        th Họ và tên 
                        th Email
                        th Quyền quản trị
                        th Trạng thái 
                        th Hành động 
            tbody 
                each item, index in accounts 
                    tr 
                        td
                            input(type="checkbox" name="id" value=item.id)
                        -const stt = (pagination.currentPage - 1) * pagination.limitPage + (index + 1)
                        td #{stt}
                        td 
                            img(src=item.avartar, alt=`avt ${item.fullName}`, width="100px", height="100px")
                        td #{item.fullName}
                        td #{item.email}  
                        if(item.role)
                            td #{item.role.title}
                        else 
                            td Đã bị khóa quyền quản trị
                        td(id="swap-status")
                            if(item.status == "active")
                                a(
                                    href="javascript:;" 
                                    class="badge badge-success"
                                    change-status 
                                    status = item.status
                                    id = item.id
                                ) Hoạt động
                            else 
                                a(
                                    href="javascript:;" 
                                    class="badge badge-danger"
                                    change-status 
                                    status = item.status
                                    id = item.id
                                    ) Không hoạt động
                        td 
                            a.btn.btn-success.btn-sm(href=`${frefixAdmin}/account/detel/${item.id}`) Chi tiết
                            d 
                            a.btn.btn-warning.btn-sm(href=`${frefixAdmin}/account/edit/${item.id}`) Sửa

                            button(class="btn btn-danger btn-sm ml-1" id=item.id button-delete) Xóa
        else 
            .container.mt-5
                .row.justify-content-center
                    .col-md-6
                        .alert.alert-warning.text-center
                            i.bi.bi-exclamation-triangle-fill 
                            | Không có tài khoản  nào!!
    form(action="", method="POST" id="form-change" path=`${frefixAdmin}/account/changeStatus`)
    form(action="" method="POST" id="form-delete" path=`${frefixAdmin}/account/delete`)
    +pagination(pagination)
    script(src="/admin/js/account.js") 