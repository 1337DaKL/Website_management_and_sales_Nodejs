extends ../../layouts/defaut.pug
block main
    h1 Tài khoản
    br
    .card.mb-3 
        .card-body
            .row 
                //-Filter-Search
                .col-4
                    //- +filter-status(filtersStatus)  
                //-End Filter-Search

                //-Search
                .col-6
                    //- +search(keyword)
                //-End Search
                .col-2
                    a(
                        href=`${frefixAdmin}/account/create`
                        class="btn btn-outline-success"
                    ) + Thêm tài khoản
    table(
        class="table table-hover table-sm"
        change-status-multi
    )
        if accounts.length > 0 
            thead 
                    tr
                        th
                            input(type="checkbox" name="checkall")
                        th STT 
                        th Ảnh đại diện
                        th Họ và tên 
                        th Email
                        th Quyền quản trị
                        th Trạng thái 
                        th Hành động 
            tbody 
                each item, index in accounts 
                    tr 
                        td
                            input(type="checkbox" name="id" value=item.id)
                        td #{index + 1}
                        td 
                            img(src=item.avatar, alt=`avt ${item.fullName}`, width="100px", height="auto")
                        td #{item.fullName}
                        td #{item.email}  
                        if(item.role)
                            td #{item.role.title}
                        else 
                            td Đã bị khóa quyền quản trị
                        td(id="swap-status")
                            if(item.status == "active")
                                a(
                                    href="javascript:;" 
                                    class="badge badge-success"
                                    change-status 
                                    status = item.status
                                    id = item.id
                                ) Hoạt động
                            else 
                                a(
                                    href="javascript:;" 
                                    class="badge badge-danger"
                                    change-status 
                                    status = item.status
                                    id = item.id
                                    ) Không hoạt động
                        td 
                            a.btn.btn-success.btn-sm(href=`${frefixAdmin}/products/detel/${item.id}`) Chi tiết
                            d 
                            a.btn.btn-warning.btn-sm(href=`${frefixAdmin}/products/edit/${item.id}`) Sửa

                            button(class="btn btn-danger btn-sm ml-1" id=item.id button-delete) Xóa
        else 
            .container.mt-5
                .row.justify-content-center
                    .col-md-6
                        .alert.alert-warning.text-center
                            i.bi.bi-exclamation-triangle-fill 
                            | Không có tài khoản  nào!!
    form(action="", method="POST" id="form-change" path=`${frefixAdmin}/account/changeStatus`)
    form(action="" method="POST" id="form-delete" path=`${frefixAdmin}/account/delete`)
    script(src="/admin/js/account.js") 