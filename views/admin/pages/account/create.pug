extends ../../layouts/defaut.pug
block main  
    h1(class="mb-4") Thêm mới sản phẩm 
    form(
        action=""
        id="form-create"
        method="POST"
        enctype="multipart/form-data"
    )
        div(class="form-group")
            label(for="fullName") Họ và tên *
            input(
                type="text"
                class="form-control"
                id="fullName"
                name="fullName"
                placeholder="Nhập họ và tên ..."
                required
            )
        div(class="form-group")
            label(for="email") Email*
            input(
                type="text"
                class="form-control"
                id="email"
                name="email"
                placeholder="Nhập email ..."
                required
            ) 

        div(class="form-group")
            label(for="password") Mật khẩu*
            input(
                id="password"
                name="password"
                type="text"
                class="form-control"
                placeholder="Nhập mật khẩu ..."
                required
            )
        div(class="form-group")
            label(for="address") Địa chỉ
            input(
                id="address"
                name="address"
                type="text"
                class="form-control"
                placeholder="Nhập địa chỉ"
            )
        div(class="form-group") 
            label(for="telephone") Số điện thoại
            input(
                id="telephone"
                name="telephone"
                type="text"
                placeholder="Nhập số điện thoại ..."
                class="form-control"
            )
        div(class="form-group")
            label(for="idRole") Quyền quản trị *
            br
            select(name="idRole" id="idRole")
                option(value="" selected) ----Chọn quyền quản trị----
                option(value="admin") Quản trị viên
                option(value="user") Người dùng
   
        div(class="form-group" upload-image)
            label(for="avatar") Tải ảnh 
            input(
                id="avatar"
                name="avatar"
                type="file"
                class="form-control-file"
                accept=".jpg, .png"
                input-image
            )
            button(type="button" id="clearUpload" clear-upload) X
            br
            <img id="blah" src="#" alt="Ảnh bạn đã tải lên" img-image weith = "200px" height = "200px"/>
        div(class="form-group form-check form-check-inline")
            label(for="statusActive" class="form-check-label" style="margin-right: 10px") Hoạt động
            input(
                type="radio"
                class="form-check-input"
                id="statusActive"
                name="status"
                value="active"
                checked
            )
        div(class="form-group form-check form-check-inline")
            label(for="statusInactive" class="form-check-label" style="margin-right: 10px") Dừng hoạt động    
            input(
                type="radio"
                class="form-check-input"
                id="statusInactive"
                name="status"
                value="inactive"
            )
        div(class="form-group")
            button(
                type="submit"
                class="btn btn-primary"
            ) Tạo mới 
    script(src="/admin/js/create.js") 

