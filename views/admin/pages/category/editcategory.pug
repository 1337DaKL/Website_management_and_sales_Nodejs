extends ../../layouts/defaut.pug
include ../../mixins/level-tree.pug
block main  
    h1(class="mb-4") Sửa loại sản phẩm
    if roleLogin.permission.includes("products-category_edit")
        form(
            action=`${frefixAdmin}/categorys/edit/${category.id}?_method=PATCH`
            id="form-edit"
            method="POST"
            enctype="multipart/form-data"
        )
            div(class="form-group")
                label(for="title") Tiêu đề
                input(
                    type="text"
                    class="form-control"
                    id="title"
                    name="title"
                    placeholder="Nhập tên sản phẩm"
                    required
                    value = category.title
                )
            div(clas="form-group")
                label(for="parent") Loại sản phẩm cha 
                br
                select(name="idParent")
                    option(value=category.idParent)  #{nameParent}
                    option(value="") Không có cha 
                    +level-tree(treeLevel)

            div(class="form-group")
                label(for="description") Mô tả
                textarea(
                    class="form-control"
                    id="description"
                    name="description"
                    rows="5"
                    
                ) #{category.description}
            div(class="form-group" upload-image)
                label(for="thumbnail") Tải ảnh 
                input(
                    id="thumbnail"
                    name="thumbnail"
                    type="file"
                    class="form-control-file"
                    accept=".jpg, .png"
                    value = category.thumbnail
                    input-image
                )
                button(type="button" id="clearUpload" clear-upload) X
                br
                img(
                    id="blah" 
                    src=category.thumbnail 
                    alt="Ảnh bạn đã tải lên" 
                    img-image 
                    width="200px" 
                    height="200px"
                )
            div(class="form-group")
                label(for="position") Vị trí
                input(
                    id="position"
                    name="position"
                    type="number"
                    class="form-control"
                    min="1"
                    placeholder="Không nhập thì vị trí tự động tăng"
                    value = category.position
                )
            div(class="form-group form-check form-check-inline")
                label(for="statusActive" class="form-check-label" style="margin-right: 10px") Hoạt động
                input(
                    type="radio"
                    class="form-check-input"
                    id="statusActive"
                    name="status"
                    value="active"
                    checked=category.status == "active" ? true : false
                )
            div(class="form-group form-check form-check-inline")
                label(for="statusInactive" class="form-check-label" style="margin-right: 10px") Dừng hoạt động    
                input(
                    type="radio"
                    class="form-check-input"
                    id="statusInactive"
                    name="status"
                    value="inactive"
                    checked=category.status == "inactive" ? true : false
                )
            div(class="form-group")
                button(
                    type="submit"
                    class="btn btn-primary"
                ) Sửa
        script(src="/admin/js/create.js") 
    else 
        h2  Bạn không có quyền truy cập vào trang này
