extends ../../layouts/defaut.pug
block main  
    -if(messages.error)
        .messages.info
            span(
                class="alert alert-danger" 
                show-alert 
                data-time= "5000"
            ) #{messages.error} <button type="button" class="btn-close" aria-label="Close" button-close-alert></button>
    h1(class="mb-4") Thêm mới loại sản phẩm
    form(
        action=""
        id="form-create"
        method="POST"
        enctype="multipart/form-data"
    )
        div(class="form-group")
            label(for="title") Tiêu đề
            input(
                type="text"
                class="form-control"
                id="title"
                name="title"
                placeholder="Nhập tên sản phẩm"
                required
            )
        div(class="form-group")
            label(for="parent") Id cha
            input(
                type="text"
                class="form-control"
                id="parent"
                name="parent"
                placeholder="Nhập id loại sản cha"
            )
        div(class="form-group")
            label(for="description") Mô tả
            textarea(
                class="form-control"
                id="description"
                name="description"
                rows="5"
            ) 
        div(class="form-group" upload-image)
            label(for="thumbnail") Tải ảnh 
            input(
                id="thumbnail"
                name="thumbnail"
                type="file"
                class="form-control-file"
                accept=".jpg, .png"
                input-image
            )
            button(type="button" id="clearUpload" clear-upload) X
            br
            <img id="blah" src="#" alt="Ảnh bạn đã tải lên" img-image weith = "200px" height = "200px"/>
        div(class="form-group")
            label(for="position") Vị trí
            input(
                id="position"
                name="position"
                type="number"
                class="form-control"
                min="1"
                placeholder="Không nhập thì vị trí tự động tăng"
            )
        div(class="form-group form-check form-check-inline")
            label(for="statusActive" class="form-check-label" style="margin-right: 10px") Hoạt động
            input(
                type="radio"
                class="form-check-input"
                id="statusActive"
                name="status"
                value="active"
                checked
            )
        div(class="form-group form-check form-check-inline")
            label(for="statusInactive" class="form-check-label" style="margin-right: 10px") Dừng hoạt động    
            input(
                type="radio"
                class="form-check-input"
                id="statusInactive"
                name="status"
                value="inactive"
            )
        div(class="form-group")
            button(
                type="submit"
                class="btn btn-primary"
            ) Tạo mới 
    script(src="/admin/js/create.js") 
