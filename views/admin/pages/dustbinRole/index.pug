extends ../../layouts/defaut.pug
include ../../mixins/search-and-apply.pug
include ../../mixins/pagination.pug
include ../../mixins/search.pug
block main 
    h1 Thùng rác quyền quản trị
    .container.mt-4
    .row.justify-content-center
        .col-md-8
            form(id="form-search")
                .input-group.mb-4
                    input.form-control(
                        type="text" 
                        placeholder="Tìm kiếm sản phẩm..." 
                        name="keyword"  
                        value=keyword 
                        )
                    button.btn.btn-outline-secondary(type="button" id="button-clear")
                        i.fa.fa-times 
                    .input-group-append
                        button.btn.btn-primary(type="submit")
                            i.bi.bi-search
                            | Tìm kiếm
            // Chọn và nút áp dụng
            form(action=`${frefixAdmin}/dustbinRole/change-multi?_method=PATCH` method="post" form-option)
                .input-group
                    select.form-control(name="type" select-option)
                        option(disabled selected) --Chọn hành động--
                        option(value="restore") Khôi phục
                        option(value="delete") Xóa vĩnh viễn
                    .input-group-append
                        button.btn.btn-success(type="submit") Áp dụng
                        .form-group.mr-2
                input.form-control.d-none(
                    type="text"
                    name="ids"
                    value=""
                    placeholder="San pham ap dung"
                    input-submit
                )

        if roles.length > 0 
            .row.mt-4   
                .col-md-12
                    table.table.table-striped.table-bordered
                        thead.thead-dark
                            tr
                                th
                                    input(type="checkbox" name="checkall")
                                th.text-center(w-10) STT
                                th.text-center(w-20) Tên quyền quản trị
                                th.text-center(w-20) Mô tả
                                th.text-center(w-20) Ngày xóa
                                th.text-center(w-20) Hành động
                        tbody
                            each item , index in roles
                                tr
                                    td  
                                        input(type="checkbox" name="id" id=item.id)
                                    td.text-center #{index + 1}
                                    td.text-center #{item.title}
                                    td.text-center !{item.description}
                                    td.text-center #{item.dateDeletedNew}
                                    td.text-center
                                        button(
                                            class="btn btn-primary mr-2"
                                            id-role = item.id
                                            restore-role
                                        ) Khôi phục
                                        button(
                                            class="btn btn-danger"
                                            id-role = item.id 
                                            delete-role
                                        ) Xóa vĩnh viễn 
        else
            .container.mt-5
                .row.justify-content-center
                    .col-md-6
                        .alert.alert-warning.text-center
                            i.bi.bi-exclamation-triangle-fill 
                            | Thùng rác rỗng

        form(action=""  method="POST" id="form-restore" path=`${frefixAdmin}/dustbinRole/restore`)
        form(action=""  method="POST" id="form-delete" path=`${frefixAdmin}/dustbinRole/delete`)
    //- +pagination(pagination)
    script(src="/admin/js/dustbinRole.js") 
    script(src="/admin/js/dustbin.js") 


