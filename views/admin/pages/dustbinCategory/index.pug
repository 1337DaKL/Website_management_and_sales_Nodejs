extends ../../layouts/defaut.pug
include ../../mixins/search-and-apply.pug
include ../../mixins/product-dustbin.pug
include ../../mixins/pagination.pug
block main
    h1 Thùng rác danh mục sản phẩm
    if roleLogin.permission.includes("products-category_view-dustbin")
        .container.mt-4
            .row.justify-content-center
                .col-md-8
                    // Thanh tìm kiếm
                    form(id="form-search")
                        .input-group.mb-4
                            input.form-control(
                                type="text" 
                                placeholder="Tìm kiếm sản phẩm..." 
                                name="keyword"  
                                value=keyword 
                                )
                            button.btn.btn-outline-secondary(type="button" id="button-clear")
                                i.fa.fa-times 
                            .input-group-append
                                button.btn.btn-primary(type="submit")
                                    i.bi.bi-search
                                    | Tìm kiếm
                    // Chọn và nút áp dụng
                    if roleLogin.permission.includes("products-category_edit-dustbin")   
                        form(action=`${frefixAdmin}/dustbinCategory/change-multi?_method=PATCH` method="post" form-option)
                            .input-group
                                select.form-control(name="type" select-option)
                                    option(disabled selected) --Chọn hành động--
                                    option(value="restore") Khôi phục
                                    option(value="delete") Xóa vĩnh viễn
                                .input-group-append
                                    button.btn.btn-success(type="submit") Áp dụng
                                    .form-group.mr-2
                            input.form-control.d-none(
                                type="text"
                                name="ids"
                                value=""
                                placeholder="San pham ap dung"
                                input-submit
                            )
            if categorys.length > 0 
                .row.mt-4
                    .col-md-12
                        table.table.table-striped.table-bordered
                            thead.thead-dark
                                tr
                                    th
                                        input(type="checkbox" name="checkall")
                                    th.text-center(w-10) STT
                                    th.text-center(w-20) Tên danh mục
                                    th.text-center(w-20) Hình ảnh
                                    th.text-center(w-20) Ngày xóa
                                    th.text-center(w-20) Người xóa
                                    th.text-center(w-20) Hành động
                            tbody
                                each item , index in categorys
                                    tr
                                        td  
                                            input(type="checkbox" name="id" id=item.id)
                                        td.text-center #{index + 1}
                                        td.text-center #{item.title}
                                        td.text-center
                                            img(src=item.thumbnail, alt=item.title, width='50')
                                        td.text-center 
                                            if item.deletedBy.dateDeleted
                                                - const date = moment(item.deletedBy.dateDeleted).format("DD/MM/YYYY HH:mm:ss")
                                                p #{date}
                                        td.text-center 
                                            if item.deletedBy.nameAccountDeleted
                                                p #{item.deletedBy.nameAccountDeleted}
                                            else 
                                                p Không có
                                        td.text-center
                                            if roleLogin.permission.includes("products-category_edit-dustbin")
                                                button(
                                                    class="btn btn-primary mr-2"
                                                    id-category = item.id
                                                    restore-category
                                                ) Khôi phục
                                                button(
                                                    class="btn btn-danger"
                                                    id-category = item.id 
                                                    delete-category
                                                ) Xóa vĩnh viễn 
                                            else 
                                                h6 Bạn không được thực hiện hành động nào
            else
                .container.mt-5
                    .row.justify-content-center
                        .col-md-6
                            .alert.alert-warning.text-center
                                i.bi.bi-exclamation-triangle-fill 
                                | Thùng rác rỗng

            form(action=""  method="POST" id="form-restore" path=`${frefixAdmin}/dustbincategory/restore`)
            form(action=""  method="POST" id="form-delete" path=`${frefixAdmin}/dustbinCategory/delete`)
        +pagination(pagination)
        script(src="/admin/js/dustbinCategory.js") 
    else 
        h2 Bạn không có quyền truy cập vào trang này
