extends ../../layouts/defaut.pug
block main  
    h1(class="mb-4") Thêm mới quyền quản tri
    form(
        action=""
        id="form-create"
        method="POST"
        enctype="multipart/form-data"
    )
        div(class="form-group")
            label(for="title") Tiêu đề
            input(
                type="text"
                class="form-control"
                id="title"
                name="title"
                placeholder="Nhập tên sản phẩm"
                required
            )
        div(class="form-group")
            label(for="description") Mô tả
            textarea(
                class="form-control"
                id="description"
                name="description"
                rows="5"
                tinymce
            ) 
        div(class="form-group")
            button(
                type="submit"
                class="btn btn-primary"
            ) Tạo mới 
    script(src="/admin/js/create.js") 
