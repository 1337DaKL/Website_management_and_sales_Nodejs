extends ../../layouts/defaut.pug
block main
    h1(class="mb-4") Phân quyền
    if roleLogin.permission.includes("role_permission")
        div(class="text-right")
            button(
                type="submit"
                class="btn btn-primary mb-3 button-submit"
                button-update
            ) Cập nhật
        div(class="d-none" data-role data=roles)
        table(class="table table-hover table-sm" table-permission)
            thead
                tr
                    
                    th(class="text-center") Tính năng
                    each role in roles
                        th(class="text-center") #{role.title}
                    
            tbody
                tr(data-name="id" class="d-none")
                    td(class="text-center" )
                    each role in roles
                        th(class="text-center" id-role=role.id) #{role.id}
                //- Quản lí danh mục sản phẩm
                tr
                    td(colspan=roles.length + 1)
                        b Danh mục sản phẩm
                tr(data-name="products-category_view")
                    td Xem
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="products-category_create")
                    td Thêm mới
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="products-category_edit")
                    td Chỉnh sửa
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="products-category_delete")
                    td Xóa
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="products-category_view-dustbin")
                    td Xem thùng rác
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="products-category_edit-dustbin")
                    td Khôi phục hoặc xóa vĩnh viễn sản phẩm
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                //- Quản lí sản phẩm
                tr
                    td(colspan=roles.length + 1)
                        b Sản phẩm
                tr(data-name="products_view")
                    td Xem
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="products_create")
                    td Thêm mới
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="products_edit")
                    td Chỉnh sửa
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="products_delete")
                    td Xóa
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="products_view-dustbin")
                    td Xem thùng rác
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="products_edit-dustbin")
                    td Khôi phục hoặc xóa vĩnh viễn
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                //-Quản lí tài khoản

                tr
                    td(colspan=roles.length + 1)
                        b Quản lí tài khoản
                tr(data-name="account_view")
                    td Xem
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="account_create")
                    td Thêm mới
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="account_edit")
                    td Chỉnh sửa
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="account_delete")
                    td Xóa
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="account_view-dustbin")
                    td Xem thùng rác
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="account_edit-dustbin")
                    td Khôi phục hoặc xóa vĩnh viễn
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                //- Quản lí tin nhắn 
                tr
                    td(colspan=roles.length + 1)
                        b Quản lí tin nhắn
                tr(data-name="messenger_view")
                    td Xem
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="messenger_delete")
                    td Xóa
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="messenger_view-dustbin")
                    td Xem thùng rác
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="messenger_edit-dustbin")
                    td Khôi phục hoặc xóa vĩnh viễn
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                //- Quyền quản trị
                tr
                    td(colspan=roles.length + 1)
                        b Quyền quản trị
                tr(data-name="role_view")
                    td Xem
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="roles_create")
                    td Thêm mới
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="role_edit")
                    td Chỉnh sửa
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="role_delete")
                    td Xóa
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="role_view-dustbin")
                    td Xem thùng rác
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="role_edit-dustbin")
                    td Khôi phục hoặc xóa vĩnh viễn
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")
                tr(data-name="role_permission")
                    td Phân quyền
                    each role in roles
                        th(class="text-center") 
                            input(type="checkbox")

        form(action=`${frefixAdmin}/role/update-permission?_method=PATCH` method="post" form-permission class="d-none") 
            input(type="text" value name="permission" input-permission)
        script(src="/admin/js/role.js") 
    else 
        h2 Bạn không có quyền truy cập vào trang này
