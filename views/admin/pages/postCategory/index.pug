extends ../../layouts/defaut.pug
include ../../mixins/pagination.pug
block main 
    if roleLogin.permission.includes("post-category_view")
        h1 Trang quản lí danh mục bài viết
        .card.mb-3 
            .card-header Bộ lọc và tìm kiếm
            .card-body
                .row 
                    .col-4
                        //- +filter-status(filtersStatus)  
                    .col-6
                        //- +search(keyword)
                    .col-2
                        if roleLogin.permission.includes("post-category_create")
                            a(
                                href=`${frefixAdmin}/postCategory/create`
                                class="btn btn-outline-success"
                            ) +Thêm mới danh mục bài viết
                .row
                    //- if roleLogin.permission.includes("products-category_edit")
                    //-     +change-status-multi()
                    //- +sort() 
        table(
            class="table table-hover table-sm"
            change-status-multi
        )
            if postCategory.length > 0 
                thead 
                        tr
                            th
                                input(type="checkbox" name="checkall")
                            th STT 
                            th Hình ảnh 
                            th Tiêu đề 
                            th Danh mục cha
                            th Vị trí
                            th Trạng thái 
                            th Ngày tạo
                            th Ngày cập nhật gần nhất
                            th Hành động 
                tbody 
                    each item, index in postCategory 
                        tr 
                            td
                                input(type="checkbox" name="id" value=item.id)
                            -const stt = (pagination.currentPage - 1) * pagination.limitPage + (index + 1)
                            td #{stt}
                            td 
                                img(src=item.thumbnail, alt=item.title, width="100px", height="auto")
                            td #{item.title}
                            if !item.idParent
                                td Không có
                            else 
                                td #{item.nameParent}
                            td 
                                input(
                                    type="number"
                                    value=item.position
                                    style="width: 60px"
                                    min="1"
                                    name="position"
                                    position-change
                                )
                            td(id="swap-status")
                                if roleLogin.permission.includes("products-category_edit")
                                    if(item.status == "active")
                                        a(
                                            href="javascript:;" 
                                            class="badge badge-success"
                                            change-status 
                                            status = item.status
                                            id = item.id
                                        ) Hoạt động
                                    else 
                                        a(
                                            href="javascript:;" 
                                            class="badge badge-danger"
                                            change-status 
                                            status = item.status
                                            id = item.id
                                            ) Không hoạt động
                                else 
                                    if(item.status == "active")
                                        a(
                                            href="javascript:;" 
                                            class="badge badge-success"
                                        ) Hoạt động
                                    else 
                                        a(
                                            href="javascript:;" 
                                            class="badge badge-danger"
                                            ) Không hoạt động
                            td 
                                if item.createdBy
                                    - const date = moment(item.createdBy.dateCreated).format("vào HH:mm:ss DD/MM/YYYY")
                                    if item.createdBy.nameAccountCreated
                                        p Người tạo: 
                                            b #{item.createdBy.nameAccountCreated}
                                    else 
                                        p Người tạo: Không có
                                    p #{date}
                            td 
                                if item.lastUpdated
                                    - const dateUpdated = moment(item.lastUpdated.dateUpdated).format("HH:mm:ss DD/MM/YYYY")
                                    if item.lastUpdated.nameAccountUpdated
                                        p Người cập nhật: 
                                            b #{item.lastUpdated.nameAccountUpdated}
                                    else 
                                        p Người cập nhật: Không có
                                    p #{dateUpdated}
                                else 
                                    p Không có thay đổi nào
                            td 
                                if roleLogin.permission.includes("products-category_view")
                                    a.btn.btn-success.btn-sm(href=`${frefixAdmin}/categorys/detel/${item.id}`) Chi tiết
                                    d 
                                if roleLogin.permission.includes("products-category_edit")
                                    a.btn.btn-warning.btn-sm(href=`${frefixAdmin}/categorys/edit/${item.id}`) Sửa
                                if roleLogin.permission.includes("products-category_delete")
                                    button(class="btn btn-danger btn-sm ml-1" id-product=item.id button-delete) Xóa
            else 
                .container.mt-5
                    .row.justify-content-center
                        .col-md-6
                            .alert.alert-warning.text-center
                                i.bi.bi-exclamation-triangle-fill 
                                | Không có danh mục sản phẩm nào!!

            form(action="", method="POST" id="form-change" path="categorys/change-status/") 
            form(action="" method="POST" id="form-delete" path=`${frefixAdmin}/categorys/delete`)
        +pagination(pagination)
        script(src="/admin/js/postCategory.js") 
    else 
        h2 Bạn không có quyền truy cập vào trang này